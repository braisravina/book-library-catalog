# Production data is never part of the build context (Phase 5C): it lives
# in /opt/digital-library-data, outside the working tree. Defence in depth
# if a copy is ever placed in the tree. No exception (!) patterns, so the
# build never has to look inside an excluded directory.
mysql
mysql-init-guard
mysql-data
data
**/*.ibd
**/ibdata*
**/ib_logfile*
**/ibtmp*
**/undo_[0-9]*
**/binlog.*
**/*.sql.gz
**/allow-empty-init

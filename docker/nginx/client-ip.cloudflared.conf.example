# Digital Library Archive - client IP policy TEMPLATE: Cloudflare Tunnel.
# Topology (Phase 5B): Cloudflare edge -> the owner's EXISTING cloudflared
# (systemd service on the Docker host) -> http://127.0.0.1:<DLA_HTTP_PORT>
# (the published loopback port) -> nginx (this container).
#
# Every connection through the published port reaches nginx from the
# gateway of the stack's "edge" network (Docker's port proxy, or loopback
# NAT, connects from it), so that gateway (DLA_EDGE_GATEWAY, fixed by
# DLA_EDGE_SUBNET) is cloudflared's address as nginx sees it.
#
# A CF-Connecting-IP header proves nothing by itself: anyone who can open a
# TCP connection to nginx can send one. Cloudflare sets it at the edge
# (replacing any value a visitor sends) and cloudflared forwards it. Here it
# is believed only from the gateway, which only processes on the Docker
# host can use (the port is bound to 127.0.0.1): every local process can
# therefore set it, so keep the host's local users and services trusted.
#
# Install (docs/DEPLOYMENT.md 0.4; nginx -t refuses this file until the
# placeholder is replaced, and the entrypoint refuses any address other
# than DLA_EDGE_GATEWAY):
#   1. Confirm the gateway from the peer= field of nginx's access log for a
#      request that came through the tunnel.
#   2. Replace <CLOUDFLARED_ADDRESS> with DLA_EDGE_GATEWAY (one address,
#      never a range or a whole Docker subnet).
#   3. Install as docker/nginx/production/client-ip.conf, set
#      DLA_TRUSTED_PROXY=required and restart nginx.
#
# CF-Connecting-IP holds exactly one address, so the header is not walked
# (real_ip_recursive off). A missing or malformed value leaves $remote_addr
# at the gateway address (never a client's choice).

set_real_ip_from <CLOUDFLARED_ADDRESS>;
real_ip_header CF-Connecting-IP;
real_ip_recursive off;

# Direct-origin protection: 1 refuses (403) requests that did not arrive
# through the trusted peer with a valid CF-Connecting-IP, except /health
# (local container probes). Local requests without the header (for
# example curl on the Docker host) are refused too.
map $uri $dla_require_trusted_proxy {
    default 1;
}

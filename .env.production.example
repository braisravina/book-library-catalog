# Digital Library Archive - PRODUCTION environment template (Phase 5A).
#
# Copy to the production host as .env.production (never commit it), review
# every value. docker-compose.prod.yml reads it twice: as the containers'
# environment (php, ops) and, with --env-file .env.production, for the
# ${...} values of the db and nginx services. The PHP container validates it
# on start (bin/console config:check) and refuses to start on errors;
# production also refuses to serve (HTTP 503) while errors remain.
#
# Secrets: never put passwords or API keys in this file. Each secret is read
# from a file through KEY_FILE (Docker secrets, mounted at /run/secrets/...).
# Generate each one separately, for example:
#     openssl rand -hex 32 > ./secrets/db_password
#     chmod 600 ./secrets/*        (owner-only; keep them out of Git and backups)
# Store copies in your password manager: they are needed to restore backups.
# File names, ownership and modes: ARCHITECTURE.md "Production secrets".
#
# APP_ROLE is set per container by docker-compose.prod.yml (php: web, ops:
# ops); do not set it here. The web container never receives the migration
# or MySQL root credentials, whatever this file contains.
#
# Enforced elsewhere (not by these settings):
#   - TLS and HTTP->HTTPS redirects: Cloudflare (edge) - set "Always Use HTTPS".
#   - Client IP / trusted proxies: nginx real_ip (docker/nginx); the
#     application only ever uses REMOTE_ADDR.
#   - CDN/tunnel request logging of invitation URLs: Cloudflare/cloudflared.
#   - Outbound egress to metadata providers: Docker host firewall.

# --- Application -------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# Exact public origin: https, no path, no trailing query/fragment. Also the
# only Host header the application answers to.
APP_URL=https://library.bravina.co.uk
APP_LOCALE=en

# --- Sessions and transport security ----------------------------------------
SESSION_SECURE_COOKIE=true
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
# Strict-Transport-Security (1 year, includeSubDomains). Make sure every
# subdomain of the registrable domain serves HTTPS before enabling preload
# anywhere; this setting does not request preload.
SECURITY_HSTS=true

# --- Login rate limiting and password hashing ---------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCKOUT_SECONDS=900
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# --- Database -------------------------------------------------------------------
# Runtime account: SELECT/INSERT/UPDATE/DELETE only. The MySQL root password is
# NOT given to the application container.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=library
DB_USERNAME=library_app
DB_PASSWORD_FILE=/run/secrets/db_password
# Migration account (schema changes); used only by `bin/console migrate`.
DB_MIGRATION_USERNAME=library_migrator
DB_MIGRATION_PASSWORD_FILE=/run/secrets/db_migration_password

# --- ISBN metadata lookup ---------------------------------------------------------
# OWNER DECISION: looked-up ISBNs are sent to these third parties. Use "none"
# to disable lookups entirely.
METADATA_PROVIDERS=open_library,google_books
# Optional Google Books API key, as a secret file:
# GOOGLE_BOOKS_API_KEY_FILE=/run/secrets/google_books_api_key
METADATA_TIMEOUT_SECONDS=8
METADATA_CACHE_DAYS=30

# --- Uploads and storage (absolute paths outside public/) ---------------------
UPLOAD_MAX_BYTES=5242880
COVER_STORAGE_PATH=/var/www/html/storage/covers
BACKUP_PATH=/var/www/html/storage/backups
TEMP_PATH=/var/www/html/storage/tmp
MAINTENANCE_FLAG_PATH=/var/www/html/storage/maintenance.flag

# --- Invitations --------------------------------------------------------------------
# Fragment links keep invitation tokens out of every request URL (Cloudflare,
# cloudflared and nginx logs). Both formats redeem the same tokens.
INVITATION_LINK_FORMAT=fragment
# Latest expiry an administrator may choose (1-90 days); shorter is safer.
INVITATION_MAX_DAYS=14
INVITATION_MAX_FAILURES=10

# --- Retention (bin/console cleanup; a dry run unless --apply) -----------------------
INVITATION_RETENTION_DAYS=90
LOGIN_ATTEMPT_RETENTION_DAYS=30
TEMP_FILE_RETENTION_HOURS=24
ORPHAN_COVER_MIN_AGE_HOURS=24
BACKUP_KEEP_COUNT=14
BACKUP_KEEP_DAYS=30

# --- Ingress (nginx container) - PENDING the production topology review --------
# "required": nginx trusts the proxy named in docker/nginx/production/
# client-ip.conf; "none": explicitly no trusted proxy. Left unset, the nginx
# container refuses to start (fail closed). Do not set it until the trusted-
# proxy design has been verified and approved.
# DLA_TRUSTED_PROXY=required

# The MySQL root password is the secrets/db_root_password file, mounted in
# the db container only.
# Not used in production (development/test only): APP_PORT, DB_ROOT_PASSWORD,
# DB_TEST_DATABASE, DB_TEST_USERNAME, DB_TEST_PASSWORD,
# DB_TEST_MIGRATION_USERNAME, DB_TEST_MIGRATION_PASSWORD,
# DB_TEST_REQUIRE_DEDICATED_ACCOUNTS.

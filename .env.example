# Digital Library Archive — environment configuration.
# Copy to .env for local development and replace every CHANGE_ME value.
# Never commit .env. In production prefer Docker secrets: any key can be given
# as KEY_FILE=/run/secrets/key instead of KEY=value.

# --- Application -----------------------------------------------------------
# production | development | testing
APP_ENV=development
# Shows exception class/message on error pages. Ignored when APP_ENV=production.
APP_DEBUG=false
# Public base URL; used to validate the Origin header on form submissions.
APP_URL=http://localhost:8080
APP_PORT=8080
# Default UI language: en | es | gl
APP_LOCALE=en

# --- Sessions ----------------------------------------------------------------
# Must be true whenever the site is served over HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
# Send Strict-Transport-Security (enable only behind HTTPS).
SECURITY_HSTS=false

# --- Login rate limiting ---------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCKOUT_SECONDS=900

# --- Password hashing (Argon2id) -----------------------------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# --- Database ------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_DATABASE=library
# Runtime account: SELECT/INSERT/UPDATE/DELETE only.
DB_USERNAME=library_app
DB_PASSWORD=CHANGE_ME_app_password
# Migration account: schema changes; used only by `bin/console migrate`.
DB_MIGRATION_USERNAME=library_migrator
DB_MIGRATION_PASSWORD=CHANGE_ME_migration_password
# Used only by the MySQL container on first initialisation.
DB_ROOT_PASSWORD=CHANGE_ME_root_password
# Optional database for the integration test suite (development only).
DB_TEST_DATABASE=library_test

# --- ISBN metadata lookup ----------------------------------------------------------------
# Providers queried, in priority order: open_library, google_books, or "none"
# to disable lookups. Looked-up ISBNs are sent to these third parties.
METADATA_PROVIDERS=open_library,google_books
# Optional Google Books API key (raises rate limits). Prefer GOOGLE_BOOKS_API_KEY_FILE.
GOOGLE_BOOKS_API_KEY=
METADATA_TIMEOUT_SECONDS=8
METADATA_CACHE_DAYS=30

# --- Uploads ---------------------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
# Absolute path outside the web root; defaults to storage/covers.
# COVER_STORAGE_PATH=/var/www/html/storage/covers

# --- Invitations (Phase 4B) -------------------------------------------------------------
# Latest expiry an administrator may choose for an invitation, in days (1-90).
INVITATION_MAX_DAYS=30
# Failed invitation-link attempts per client address within LOGIN_LOCKOUT_SECONDS.
INVITATION_MAX_FAILURES=10
# APP_URL above is used to build invitation links; in production it must be
# https://library.bravina.co.uk (or the real public address).

# --- Backups, maintenance mode and retention (Phase 4B) --------------------------------------
# Where bin/console backup:create writes archives. Must be outside public/;
# in production mount persistent storage here and copy archives off-site.
# BACKUP_PATH=/var/www/html/storage/backups
# Private working directory for restores.
# TEMP_PATH=/var/www/html/storage/tmp
# Flag file that switches the web application to maintenance mode (503).
# MAINTENANCE_FLAG_PATH=/var/www/html/storage/maintenance.flag
# Retention used by `bin/console cleanup` (a dry run unless --apply).
INVITATION_RETENTION_DAYS=90
LOGIN_ATTEMPT_RETENTION_DAYS=30
TEMP_FILE_RETENTION_HOURS=24
ORPHAN_COVER_MIN_AGE_HOURS=24
# Keep the newest N backups AND every backup younger than N days. The newest
# backup that passes verification is never deleted.
BACKUP_KEEP_COUNT=14
BACKUP_KEEP_DAYS=30
